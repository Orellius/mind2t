{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind2t",
  "mainBinaryName": "mind2t",
  "version": "0.1.0",
  "identifier": "com.orellius.mind2t",
  "build": {
    "frontendDist": "../../chrome/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A terminal on its own VT engine",
    "longDescription": "Mind2t is a terminal built on mind2t-vt, a Rust VT core gated against libghostty-vt by a differential oracle. The grid, the pty and the renderer are the project's own.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
